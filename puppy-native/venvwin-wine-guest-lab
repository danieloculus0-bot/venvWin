#!/bin/sh
# TEST BRANCH ONLY. Explicit QEMU laboratory opt-in, NEVER a production startup service.
# Executes ONLY inside disposable networked BookwormPup64 guest.
# Real guest serial evidence is gathered by QEMU, not inferred from host Wine.
set -u
LAB=/opt/venvwin/wine-lab
[ -f "$LAB/EXPERIMENT_ONLY" ] || exit 0
OUT=/tmp/venvwin-wine-lab
mkdir -p "$OUT"
LOG="$OUT/guest.log"
exec >>"$LOG" 2>&1
emit() {
  printf '%s\n' "$*" 
  if [ -c /dev/ttyS0 ]; then printf '%s\n' "$*" >/dev/ttyS0 2>/dev/null || true; fi
}
fail() { emit "VENVWIN_WINE_GUEST_BLOCKER=$1"; exit 1; }
# Startup and actual serial originate inside the virtual machine.
emit "VENVWIN_WINE_GUEST_LAB_STARTED"
emit "VENVWIN_WINE_GUEST_KERNEL=$(uname -r)"
emit "VENVWIN_WINE_GUEST_LIBC=$(getconf GNU_LIBC_VERSION 2>/dev/null || echo unavailable)"
test -x /usr/local/bin/venvwin || fail NO_VENVWIN_CLI
test -f "$LAB/Setup.exe" && test -f "$LAB/SimpleMsi.msi" && test -f "$LAB/SmokeApp.exe" || fail NO_REAL_WINDOWS_INSTALLERS
for count in $(seq 1 24); do
  grep -Fxq 'PUPPY_GUEST_BOOT_PROVEN' /tmp/venvwin-puppy-guest-proof.log 2>/dev/null && break
  sleep 5
done
grep -Fxq 'PUPPY_GUEST_BOOT_PROVEN' /tmp/venvwin-puppy-guest-proof.log 2>/dev/null || fail NO_AUTOMATIC_PUPPY_GUEST_BOOT_WITNESS
emit "VENVWIN_WINE_GUEST_BOOT_INDEPENDENTLY_PROVEN"
command -v apt-get >/dev/null 2>&1 || fail GUEST_APT_MISSING
command -v dpkg >/dev/null 2>&1 || fail GUEST_DPKG_MISSING
# Actual failure logs retained inside guest; emit only outcome/diagnostics to serial.
if command -v wine >/dev/null 2>&1; then
  emit "VENVWIN_WINE_PREINSTALLED=$(wine --version 2>&1)"
fi
# Under NO circumstances touch any host disk or persistent Puppy save file.
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export WINEDEBUG=-all
export WINEARCH=win64
if ! dpkg --add-architecture i386 >"$OUT/dpkg-add.log" 2>&1; then
  tail -n 10 "$OUT/dpkg-add.log" | while IFS= read -r x; do emit "GUEST_DPKG_DIAGNOSTIC=$x"; done
  fail MULTIARCH_REGISTRATION
fi
emit "VENVWIN_WINE_GUEST_MULTIARCH_CONFIGURED"
# Bounded network and package installation, in the live disposable QEMU guest only.
timeout 420 apt-get -o Acquire::Retries=1 -o Acquire::http::Timeout=25 update >"$OUT/apt-update.log" 2>&1 ||
  { tail -n 12 "$OUT/apt-update.log" | while IFS= read -r x; do emit "GUEST_APT_DIAGNOSTIC=$x"; done; fail APT_UPDATE; }
emit "VENVWIN_WINE_GUEST_APT_UPDATE_PASS"
# A dry-run validates package availability before we spend time downloading/installing it.
timeout 90 apt-get -s -o APT::Get::Fix-Missing=false install wine wine64 wine32:i386 >"$OUT/apt-sim.log" 2>&1 ||
  { tail -n 15 "$OUT/apt-sim.log" | while IFS= read -r x; do emit "GUEST_APT_DIAGNOSTIC=$x"; done; fail APT_SIMULATE_WINE32; }
emit "VENVWIN_WINE_GUEST_APT_CANDIDATES_RESOLVED"
timeout 540 apt-get -y --no-install-recommends -o Dpkg::Use-Pty=0 -o Acquire::Retries=1 -o Acquire::http::Timeout=25 install wine wine64 wine32:i386 >"$OUT/apt-install.log" 2>&1 ||
  { tail -n 20 "$OUT/apt-install.log" | while IFS= read -r x; do emit "GUEST_APT_DIAGNOSTIC=$x"; done; fail WINE32_INSTALL; }
command -v wine >/dev/null 2>&1 || fail NO_WINE_BINARY_AFTER_INSTALL
emit "VENVWIN_WINE_GUEST_VERSION=$(wine --version 2>&1)"
emit "VENVWIN_WINE_GUEST_RUNTIME_INSTALLED"
# Isolate two Windows installation tests, each in a separate real Wine capsule.
for CASE in nsis-exe wix-msi; do
  case "$CASE" in
    nsis-exe) SETUP="$LAB/Setup.exe"; CAPSULE=setup;;
    wix-msi) SETUP="$LAB/SimpleMsi.msi"; CAPSULE=simplemsi;;
  esac
  HOME_DIR="$OUT/$CASE-capsule-store"
  mkdir -p "$HOME_DIR"
  export VENVWIN_HOME="$HOME_DIR"
  /usr/local/bin/venvwin init >"$OUT/$CASE-init.log" 2>&1 || fail "$CASE-CAPSULE_INIT"
  emit "VENVWIN_WINE_GUEST_INSTALL_START=$CASE"
  timeout 165 /usr/local/bin/venvwin open "$SETUP" >"$OUT/$CASE-install.json" 2>"$OUT/$CASE-install-stderr.log"
  RESULT=$?
  if [ "$RESULT" -ne 0 ]; then
    tail -n 8 "$OUT/$CASE-install-stderr.log" | while IFS= read -r x; do emit "GUEST_WINE_DIAGNOSTIC=$CASE:$x"; done
    emit "VENVWIN_WINE_GUEST_INSTALL_FAILED=$CASE:$RESULT"
    continue
  fi
  # Verify an actual installed binary, never trust only the installer return code.
  TARGET=$(find "$HOME_DIR/capsules/$CAPSULE" -type f -iname 'SmokeApp.exe' 2>/dev/null | head -n 1)
  [ -n "$TARGET" ] && [ -f "$TARGET" ] || { emit "VENVWIN_WINE_GUEST_APP_MISSING=$CASE"; continue; }
  ORIGINAL_SHA=$(sha256sum "$LAB/SmokeApp.exe" | cut -d' ' -f1)
  INSTALLED_SHA=$(sha256sum "$TARGET" | cut -d' ' -f1)
  [ "$ORIGINAL_SHA" = "$INSTALLED_SHA" ] || { emit "VENVWIN_WINE_GUEST_APP_HASH_MISMATCH=$CASE"; continue; }
  emit "VENVWIN_WINE_GUEST_APP_INSTALLED=$CASE"
  timeout 120 /usr/local/bin/venvwin run "$CAPSULE" "$TARGET" >"$OUT/$CASE-launch.json" 2>"$OUT/$CASE-launch-stderr.log"
  RESULT=$?
  if [ "$RESULT" -ne 0 ]; then emit "VENVWIN_WINE_GUEST_LAUNCH_FAILED=$CASE:$RESULT"; continue; fi
  PREFIX="$HOME_DIR/capsules/$CAPSULE/prefix"
  # Actual prefix_path is sourced from capsule metadata because layout is versioned.
  PREFIX=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["prefix_path"])' "$HOME_DIR/capsules/$CAPSULE/capsule.json" 2>/dev/null) ||
    { emit "VENVWIN_WINE_GUEST_PREFIX_UNOBSERVED=$CASE"; continue; }
  MARKER="$PREFIX/drive_c/venvwin-simple-app-ran.txt"
  [ -f "$MARKER" ] && [ "$(cat "$MARKER")" = REAL_WINDOWS_APPLICATION_LAUNCHED ] ||
    { emit "VENVWIN_WINE_GUEST_APPLICATION_MARKER_MISSING=$CASE"; continue; }
  # Emit raw capsule commands/receipts to QEMU serial for independently parsed evidence.
  emit "VENVWIN_WINE_GUEST_APP_MARKER_VERIFIED=$CASE"
  for KIND in install launch; do
    FILE="$OUT/$CASE-$KIND.json"
    emit "VENVWIN_WINE_GUEST_RECEIPT_BEGIN=$CASE:$KIND"
    base64 "$FILE" | tr -d '\n' > /dev/ttyS0 2>/dev/null || true
    printf '\n' >/dev/ttyS0 2>/dev/null || true
    emit "VENVWIN_WINE_GUEST_RECEIPT_END=$CASE:$KIND"
  done
  emit "VENVWIN_WINE_GUEST_CASE_PASS=$CASE"
done
emit "VENVWIN_WINE_GUEST_LAB_FINISHED"
